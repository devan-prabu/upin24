# WIRflow backend configuration.
# Copy to .env and export before starting, or set these on your hosting platform.
# The server reads plain environment variables (no dotenv dependency):
#   export $(grep -v '^#' .env | xargs) && npm start

# ── Pick ONE provider block below and fill in your key ──────────────────────
# Every parse costs ~500 tokens, so ANY of these is a fraction of a cent per WIR.

# DeepSeek (very cheap)
#LLM_PROVIDER=openai
#LLM_BASE_URL=https://api.deepseek.com
#LLM_MODEL=deepseek-chat
#LLM_API_KEY=sk-...

# Groq (fast, generous free tier)
#LLM_PROVIDER=openai
#LLM_BASE_URL=https://api.groq.com/openai/v1
#LLM_MODEL=llama-3.3-70b-versatile
#LLM_API_KEY=gsk_...

# OpenRouter (one key, routes to whichever model is cheapest that day)
#LLM_PROVIDER=openai
#LLM_BASE_URL=https://openrouter.ai/api/v1
#LLM_MODEL=deepseek/deepseek-chat
#LLM_API_KEY=sk-or-...

# Google Gemini via its OpenAI-compatible endpoint
#LLM_PROVIDER=openai
#LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#LLM_MODEL=gemini-2.0-flash
#LLM_API_KEY=AIza...

# Anthropic Claude (Haiku 4.5 is the cheap tier: $1/$5 per MTok)
#LLM_PROVIDER=anthropic
#LLM_BASE_URL=https://api.anthropic.com
#LLM_MODEL=claude-haiku-4-5
#LLM_API_KEY=sk-ant-...

# OpenAI
#LLM_PROVIDER=openai
#LLM_BASE_URL=https://api.openai.com/v1
#LLM_MODEL=gpt-4o-mini
#LLM_API_KEY=sk-...

# ── Server settings ──────────────────────────────────────────────────────────
#PORT=3000
#LLM_TIMEOUT_MS=30000
#RATE_LIMIT_PER_MIN=20
